# ──────────────────────────────────────────────────────────────────────────────
# Next.js environment (.env.local)
# ──────────────────────────────────────────────────────────────────────────────

# Convex deployment URL — printed by `npx convex dev` (looks like https://<name>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment identifier — written automatically by `npx convex dev`
# CONVEX_DEPLOYMENT=

# Clerk keys — from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Email-in capture (optional) — the inbound mailbox your provider gives you,
# e.g. a1b2c3d4@inbound.postmarkapp.com or capture@in.yourdomain.com.
# The app shows each user their address as local+<token>@domain.
# NEXT_PUBLIC_INBOUND_EMAIL_BASE=

# ──────────────────────────────────────────────────────────────────────────────
# Convex deployment environment (set in the Convex dashboard or via
# `npx convex env set KEY value` — NOT in this file; these never reach the client)
# ──────────────────────────────────────────────────────────────────────────────
#
#   CLERK_JWT_ISSUER_DOMAIN        → your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
#                                    (shown when you create the "convex" JWT template in Clerk)
#   OPENAI_API_KEY                 → sk-... (used only inside Convex actions, server-side)
#   CLERK_SECRET_KEY               → same value as above; needed on Convex too so actions can
#                                    fetch Google Calendar tokens from Clerk (tokens never stored)
#   INBOUND_EMAIL_WEBHOOK_SECRET   → optional shared secret for the /inbound-email webhook;
#                                    put the same value in the webhook URL (?secret=...)
#   POSTMARK_SERVER_TOKEN          → optional; enables morning brief / Sunday review emails
#   EMAIL_FROM                     → optional; a verified Postmark sender, e.g. loops@yourdomain.com
#   APP_BASE_URL                   → optional; e.g. https://loops.yourdomain.com — used for
#                                    deep links in notification emails
